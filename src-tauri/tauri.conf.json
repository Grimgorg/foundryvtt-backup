{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoundryVTT Backup",
  "version": "0.2.0",
  "identifier": "io.github.grimgorg.foundryvtt-backup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FoundryVTT Backup",
        "width": 960,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Back up Foundry VTT worlds to a cloud folder",
    "longDescription": "Back up and restore Foundry VTT worlds to and from a cloud-synced folder, to keep worlds in sync between computers.",
    "copyright": "© 2026 Grimgorg. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
